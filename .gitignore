# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/

# Node (only if you add tooling later)
node_modules/
npm-debug.log*
*.log

# Local jsdom test harness (depends on an external jsdom install)
.srdtest/

# Local builds / packaging output
/dist/
/build/
*.app
*.exe
*.7z
# legacy portable location (now emitted at dist/spawn-row-duel.portable.html)
spawn-row-duel-v26.portable.html

# Optional: keep large art masters out of git (uncomment if you store them here)
# *.psd
# *.xcf
# *.kra

# ─────────────────────────────────────────────────────────────
# Unity project (unity/) — Unity 6000.5.5f1, URP
# Anchored to unity/ so the HTML build's own dist//build/ rules stay independent.
# ─────────────────────────────────────────────────────────────
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/

# Asset meta data for folders Unity itself ignores
unity/[Aa]ssets/AssetStoreTools*
unity/[Aa]ssets/Plugins/Editor/JetBrains*

# Generated IDE / solution files — Unity regenerates these on demand
unity/.vs/
unity/.gradle/
unity/*.csproj
unity/*.unityproj
unity/*.sln
unity/*.suo
unity/*.tmp
unity/*.user
unity/*.userprefs
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db

# Unity3D generated crash / profiler output
unity/sysinfo.txt

# Card art junction -> <repo>/assets/cards (tools/setup-unity-links.mjs). The real
# files and their .meta sidecars are tracked at assets/cards/; recursing into the
# junction would duplicate all of it. The folder Cards.meta sidecar IS tracked.
unity/[Aa]ssets/Game/Art/Cards/
unity/crashlytics-build.properties
unity/*.stackdump

# Built player output
unity/*.apk
unity/*.aab
unity/*.unitypackage
unity/*.app

# Burst / IL2CPP build residue emitted next to the project during player builds
unity/[Dd]ata/

# differential-harness debugging dumps (regenerated on demand)
tools/diffjs/golden/*.proj.jsonl

# fuzz traces: generated on demand by tools/diffjs/fuzz.mjs, never committed
tools/diffjs/fuzz/
